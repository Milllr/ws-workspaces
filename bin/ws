#!/usr/bin/env bash
# ws — per-branch git worktree "workspaces" for parallel Claude Code sessions.
#
# Portable core: bash 3.2+ (macOS default), Linux, Git Bash, WSL. zsh users get it
# too since it's an external command. Windows-native uses the PowerShell port.
#
# `ws cd` needs the shell-function wrapper (shell/hook.*) to change the *calling*
# shell's directory; the bare command falls back to spawning a subshell.
#
# Full docs: README.md.  No strict mode on purpose — many git calls "fail" as
# control flow and `set -e` would abort on them.

WS_VERSION="2.0.0"

# --------------------------------------------------------------------------- #
# self-location (resolve symlinks; bash 3.2 friendly)
# --------------------------------------------------------------------------- #
_ws_self_dir() {
  local src="${BASH_SOURCE[0]:-$0}" dir
  while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}
WS_SELF_DIR="$(_ws_self_dir)"

# find a bundled asset in either the installed (flat) or repo layout
_ws_asset() {
  local n="$1" c
  for c in "$WS_SELF_DIR/$n" "$WS_SELF_DIR/../common/$n" "$WS_SELF_DIR/../macos/$n" "$WS_SELF_DIR/../lib/$n"; do
    [ -f "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

# --------------------------------------------------------------------------- #
# config + defaults
# --------------------------------------------------------------------------- #
WS_CONFIG_DIR="${WS_CONFIG_DIR:-$HOME/.config/ws}"
[ -f "$WS_CONFIG_DIR/config" ] && . "$WS_CONFIG_DIR/config"
: "${WS_HOME:=$HOME/worktrees}"
# Seeded into each new worktree (gitignored local files a fresh checkout lacks).
# .claude/settings.local.json carries your approved Claude permissions across
# workspaces so Claude doesn't re-prompt in every one.
: "${WS_COPY:=.env .claude/settings.local.json}"
: "${WS_EDITOR:=auto}"
: "${WS_IDEA_WAIT:=15}"

# --------------------------------------------------------------------------- #
# tiny helpers
# --------------------------------------------------------------------------- #
_ws_is_mac() { [ "$(uname -s)" = "Darwin" ]; }
_ws_say()    { printf 'ws: %s\n' "$*"; }
_ws_err()    { printf 'ws: %s\n' "$*" >&2; }
_ws_die()    { _ws_err "$*"; exit 1; }

_ws_in_repo()      { git rev-parse --git-dir >/dev/null 2>&1; }
_ws_require_repo() { _ws_in_repo || _ws_die "not inside a git repo"; }

# path/name of the MAIN checkout (works from the main checkout or any worktree)
_ws_main_path() { git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -1; }
_ws_repo_name() { local m; m="$(_ws_main_path)"; [ -n "$m" ] || return 1; basename "$m"; }
_ws_base() { printf '%s/%s\n' "$WS_HOME" "$(_ws_repo_name)"; }
_ws_dir()  { printf '%s/%s/%s\n' "$WS_HOME" "$(_ws_repo_name)" "$1"; }

# Where sibling repos live (for -a): $WS_CODE_ROOT (colon-separated) or the parent
# directory of the current repo's main checkout.
_ws_code_roots() {
  if [ -n "${WS_CODE_ROOT:-}" ]; then printf '%s\n' "$WS_CODE_ROOT" | tr ':' '\n'
  else dirname "$(_ws_main_path)"; fi
}
# Resolve a repo name (or explicit path) to its main-checkout dir; prints or fails.
_ws_resolve_repo() {
  local nm="$1" cand root
  case "$nm" in
    /*|~*|./*|../*)
      cand="${nm/#\~/$HOME}"
      git -C "$cand" rev-parse --show-toplevel 2>/dev/null && return 0
      return 1 ;;
  esac
  while IFS= read -r root; do
    [ -n "$root" ] || continue
    if git -C "$root/$nm" rev-parse --git-dir >/dev/null 2>&1; then
      printf '%s\n' "$root/$nm"; return 0
    fi
  done <<EOF
$(_ws_code_roots)
EOF
  return 1
}

_ws_valid_name() {
  case "$1" in
    ""|*" "*|*/*|.*) return 1 ;;   # no empty / spaces / slashes / leading dot
  esac
  return 0
}

_ws_names() {           # one workspace name per line for the current repo
  _ws_in_repo || return 0
  local base; base="$(_ws_base)"
  [ -d "$base" ] || return 0
  ls -1 "$base" 2>/dev/null
}

# --------------------------------------------------------------------------- #
# seeding + marker
# --------------------------------------------------------------------------- #
_ws_seed() {
  local dir="$1" root repo f line seedlist
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  repo="$(_ws_repo_name)"
  local -a files=()
  for f in $WS_COPY; do files+=("$f"); done
  seedlist="$WS_CONFIG_DIR/seed/$repo.txt"
  if [ -f "$seedlist" ]; then
    while IFS= read -r line; do [ -n "$line" ] && files+=("$line"); done < "$seedlist"
  fi
  for f in "${files[@]}"; do
    [ -n "$f" ] || continue
    if [ -e "$root/$f" ] && [ ! -e "$dir/$f" ]; then
      mkdir -p "$dir/$(dirname "$f")" 2>/dev/null
      cp -R "$root/$f" "$dir/$f" 2>/dev/null && _ws_say "seeded $f"
    fi
  done
}

# Marker read by the shell hook: a QUEUE of launch specs, one per line. Each new
# terminal in the worktree pops the first line. Specs: "fresh" | "continue" |
# "resume <uuid>" | "prompt <text>". One spec:
_ws_mark() { printf '%s\n' "$2" > "$1/.ws-autoclaude"; }
# Multiple specs (e.g. one Claude session per line, for session restore):
_ws_mark_queue() {
  local d="$1"; shift
  : > "$d/.ws-autoclaude"
  local s; for s in "$@"; do printf '%s\n' "$s" >> "$d/.ws-autoclaude"; done
}

# --------------------------------------------------------------------------- #
# editor
# --------------------------------------------------------------------------- #
_ws_resolve_editor() {
  case "$WS_EDITOR" in
    none) printf 'none\n' ;;
    auto)
      if   command -v idea   >/dev/null 2>&1; then printf 'idea\n'
      elif command -v code   >/dev/null 2>&1; then printf 'code\n'
      elif command -v cursor >/dev/null 2>&1; then printf 'cursor\n'
      else printf 'none\n'; fi ;;
    *) printf '%s\n' "$WS_EDITOR" ;;
  esac
}

_ws_open() {
  local dir="$1" name="$2" ed
  ed="$(_ws_resolve_editor)"
  _ws_say "$name -> $dir"
  if [ "$ed" = none ]; then
    _ws_say "no editor (WS_EDITOR=none). Enter it with: ws cd $name   (then: claude)"
    return 0
  fi
  if ! command -v "$ed" >/dev/null 2>&1; then
    _ws_say "editor '$ed' not on PATH — open $dir manually, then run: claude"
    return 0
  fi
  "$ed" "$dir" >/dev/null 2>&1 || { _ws_say "'$ed' failed to open $dir"; return 0; }

  if [ "$ed" = idea ] && _ws_is_mac && [ -z "${WS_NO_UI:-}" ]; then
    local applescript; applescript="$(_ws_asset idea_open.applescript)" || return 0
    local do_term=1 do_merge=1 err
    [ -n "${WS_NO_TERMINAL:-}" ] && do_term=0
    [ -n "${WS_NO_MERGE:-}" ]    && do_merge=0
    err="$(osascript "$applescript" "$name" "$do_term" "$do_merge" "$WS_IDEA_WAIT" 2>&1 >/dev/null)" || {
      _ws_say "IntelliJ automation failed (${err:-no message})."
      printf '    Grant the app you run ws from (Terminal/IntelliJ) BOTH Accessibility AND\n' >&2
      printf '    Automation (System Events), then quit & reopen it. Or set WS_NO_UI=1.\n' >&2
      printf '    Meanwhile: in IntelliJ press Opt+F12 and Claude auto-starts.\n' >&2
    }
  else
    _ws_say "open the editor terminal in this folder and Claude auto-starts (marker hook)."
  fi
}

# --------------------------------------------------------------------------- #
# picker (fzf if present, else numbered)
# --------------------------------------------------------------------------- #
_ws_pick() {
  local -a names=(); local n
  while IFS= read -r n; do [ -n "$n" ] && names+=("$n"); done <<EOF
$(_ws_names)
EOF
  if [ "${#names[@]}" -eq 0 ]; then
    _ws_err "no workspaces for '$(_ws_repo_name)' — create one: ws -n <name>"
    return 1
  fi
  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "${names[@]}" | fzf --prompt="ws> " --height=40% --reverse --no-multi
    return $?
  fi
  local i=1
  { printf 'workspaces for %s:\n' "$(_ws_repo_name)"
    for n in "${names[@]}"; do printf '  %d) %s\n' "$i" "$n"; i=$((i+1)); done
    printf 'select [1-%d]: ' "${#names[@]}"; } >&2
  local choice; read -r choice
  case "$choice" in ''|*[!0-9]*) _ws_err "cancelled"; return 1 ;; esac
  if [ "$choice" -ge 1 ] && [ "$choice" -le "${#names[@]}" ]; then
    printf '%s\n' "${names[$((choice-1))]}"
  else
    _ws_err "cancelled"; return 1
  fi
}

# resolve a name arg, falling back to the picker
_ws_resolve_name() {
  local name="${1:-}"
  if [ -z "$name" ]; then name="$(_ws_pick)" || return 1; fi
  [ -n "$name" ] || return 1
  printf '%s\n' "$name"
}

# --------------------------------------------------------------------------- #
# commands
# --------------------------------------------------------------------------- #
# --- per-repo primitives (assume CWD is inside the target repo) --------------
_ws_do_new_one() {
  local name="$1" base="$2" prompt="$3" dir
  dir="$(_ws_dir "$name")"
  [ -e "$dir" ] && { _ws_err "[$(_ws_repo_name)] workspace exists: $dir"; return 1; }
  mkdir -p "$(_ws_base)"
  if git show-ref --verify --quiet "refs/heads/$name"; then
    git worktree add "$dir" "$name" || return 1
  elif git ls-remote --exit-code --heads origin "$name" >/dev/null 2>&1; then
    git worktree add --track -b "$name" "$dir" "origin/$name" || return 1
  elif [ -n "$base" ]; then
    git worktree add -b "$name" "$dir" "$base" || return 1
  else
    git worktree add -b "$name" "$dir" || return 1
  fi
  _ws_seed "$dir"
  if [ -n "$prompt" ]; then _ws_mark "$dir" "prompt $prompt"; else _ws_mark "$dir" fresh; fi
  _ws_open "$dir" "$name"
}
_ws_do_resume_one() {
  local name="$1" dir
  dir="$(_ws_dir "$name")"
  [ -d "$dir" ] || { _ws_err "[$(_ws_repo_name)] no such workspace: $name"; return 1; }
  _ws_mark "$dir" continue
  _ws_open "$dir" "$name"
}
# ensure-and-open: resume if it exists, else create. Used for -a target repos.
_ws_do_ensure_one() {
  local name="$1" base="$2" prompt="$3" dir
  dir="$(_ws_dir "$name")"
  if [ -d "$dir" ]; then _ws_do_resume_one "$name"; else _ws_do_new_one "$name" "$base" "$prompt"; fi
}

# Run ensure-and-open for the same workspace name across sibling repos.
_ws_run_across() {
  local name="$1" prompt="$2"; shift 2
  local r path
  for r in "$@"; do
    path="$(_ws_resolve_repo "$r")" || { _ws_err "── skip '$r': no such repo under $(_ws_code_roots | tr '\n' ':')  (set WS_CODE_ROOT?)"; continue; }
    _ws_say "── also: $(basename "$path") ──"
    ( cd "$path" && _ws_do_ensure_one "$name" "" "$prompt" )
  done
}
# Split a raw "-a" token blob (space- and/or comma-separated) then fan out.
_ws_run_across_split() {
  local name="$1" prompt="$2" raw="$3"
  [ -n "$raw" ] || return 0
  local -a repos=(); local t
  for t in ${raw//,/ }; do [ -n "$t" ] && repos+=("$t"); done
  [ "${#repos[@]}" -gt 0 ] && _ws_run_across "$name" "$prompt" "${repos[@]}"
}

_ws_cmd_new() {
  local name="" base="" prompt="" repos="" state=pos
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--also)   state=repos ;;
      -p|--prompt) shift; prompt="${1:-}"; state=pos ;;
      --)          shift; prompt="$*"; break ;;
      -*)          _ws_err "ignoring unknown flag: $1" ;;
      *) if [ "$state" = repos ]; then repos="$repos $1"
         elif [ -z "$name" ]; then name="$1"; elif [ -z "$base" ]; then base="$1"; fi ;;
    esac
    shift
  done
  [ -n "$name" ] || _ws_die "usage: ws new <name> [base] [-a repo,repo] [-- <prompt>]"
  _ws_valid_name "$name" || _ws_die "invalid name '$name' (no spaces, slashes, or leading dot)"
  _ws_require_repo
  _ws_do_new_one "$name" "$base" "$prompt"
  _ws_run_across_split "$name" "$prompt" "$repos"
}

# `ws -a <repo>[,repo...]` from within a workspace: set up the SAME-named
# workspace (= current branch) in the other repo(s) too.
_ws_cmd_also() {
  _ws_require_repo
  local repos="$*"
  [ -n "$repos" ] || _ws_die "usage: ws -a <repo>[,repo...]  (adds current workspace to other repos)"
  local name; name="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  [ -n "$name" ] && [ "$name" != HEAD ] || _ws_die "can't determine current branch (detached HEAD?)"
  _ws_say "using workspace name '$name' (current branch)"
  _ws_run_across_split "$name" "" "$repos"
}

# Default branch of a repo (origin/HEAD, else origin/main, else origin/master).
_ws_default_branch() {
  local dir="$1" d
  d="$(git -C "$dir" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
  d="${d#origin/}"
  if [ -z "$d" ]; then
    if git -C "$dir" show-ref --verify --quiet refs/remotes/origin/main; then d=main
    elif git -C "$dir" show-ref --verify --quiet refs/remotes/origin/master; then d=master; fi
  fi
  printf '%s\n' "$d"
}

# fetch + rebase one worktree's branch onto the latest default branch. Safe:
# skips a dirty tree, and aborts (never leaves a half-rebase) on conflict.
_ws_update_one() {
  local dir="$1" label branch def
  label="$(basename "$dir")"
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
    _ws_err "[$label] uncommitted changes — skipping (commit or stash first)"; return 1
  fi
  git -C "$dir" fetch --quiet --prune origin 2>/dev/null || { _ws_err "[$label] fetch failed"; return 1; }
  def="$(_ws_default_branch "$dir")"
  [ -n "$def" ] || { _ws_err "[$label] can't determine default branch"; return 1; }
  if git -C "$dir" rebase "origin/$def" >/dev/null 2>&1; then
    _ws_say "[$label] $branch rebased onto origin/$def ✓"
  else
    git -C "$dir" rebase --abort >/dev/null 2>&1
    _ws_err "[$label] conflicts rebasing onto origin/$def — aborted. Resolve manually: (cd \"$dir\" && git rebase origin/$def)"
    return 1
  fi
}

# Find same-named workspaces in OTHER sibling repos (under the code roots).
_ws_discover_same() {
  local name="$1" root d repo wdir curname
  curname="$(basename "$(_ws_main_path)")"
  while IFS= read -r root; do
    [ -d "$root" ] || continue
    for d in "$root"/*; do
      [ -d "$d" ] || continue
      repo="$(basename "$d")"
      [ "$repo" = "$curname" ] && continue
      git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || continue
      wdir="$WS_HOME/$repo/$name"
      [ -d "$wdir" ] && printf '%s\n' "$wdir"
    done
  done <<EOF
$(_ws_code_roots)
EOF
}

_ws_cmd_update() {
  _ws_require_repo
  local repos_raw="$*"
  local name; name="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  [ -n "$name" ] && [ "$name" != HEAD ] || _ws_die "can't determine current branch (detached HEAD?)"
  local cur; cur="$(git rev-parse --show-toplevel 2>/dev/null)"
  local -a targets=()
  if [ -n "$repos_raw" ]; then
    local t path repo wdir
    for t in ${repos_raw//,/ }; do
      [ -n "$t" ] || continue
      path="$(_ws_resolve_repo "$t")" || { _ws_err "── skip '$t': no such repo"; continue; }
      repo="$(basename "$path")"; wdir="$WS_HOME/$repo/$name"
      if [ -d "$wdir" ]; then targets+=("$wdir"); else _ws_err "── $repo: no '$name' workspace — skipping"; fi
    done
  else
    targets+=("$cur")
    local wdir
    while IFS= read -r wdir; do [ -n "$wdir" ] && targets+=("$wdir"); done <<EOF
$(_ws_discover_same "$name")
EOF
  fi
  [ "${#targets[@]}" -gt 0 ] || { _ws_say "no matching workspaces to update"; return 0; }
  _ws_say "updating '$name' → fetch + rebase onto origin default"
  local d
  for d in "${targets[@]}"; do _ws_update_one "$d"; done
}

# --- session save/restore ---------------------------------------------------
# IntelliJ config dir (latest), macOS or Linux.
_ws_ij_config_dir() {
  local d
  for d in "$HOME/Library/Application Support/JetBrains/IntelliJIdea"* "$HOME/.config/JetBrains/IntelliJIdea"*; do
    [ -d "$d" ] && printf '%s\n' "$d"
  done | sort | tail -1
}
# Open project paths from recentProjects.xml (opened="true"), $USER_HOME$ expanded.
_ws_open_projects() {
  awk -v home="$HOME" '
    match($0, /key="[^"]*"/) { k = substr($0, RSTART+5, RLENGTH-6) }
    /opened="true"/ { if (k != "") { gsub(/\$USER_HOME\$/, home, k); print k; k="" } }
  ' "$1"
}
_ws_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null; }
# Claude session UUIDs for a project path, recently active first, capped.
_ws_recent_sessions() {
  local path="$1" slug dir mins max f
  slug="$(printf '%s' "$path" | sed 's#/#-#g')"
  dir="$HOME/.claude/projects/$slug"
  [ -d "$dir" ] || return 0
  mins=$(( ${WS_ACTIVE_WINDOW:-18} * 60 )); max=${WS_MAX_SESSIONS:-4}
  find "$dir" -maxdepth 1 -name '*.jsonl' -type f -mmin "-$mins" 2>/dev/null \
    | while IFS= read -r f; do printf '%s\t%s\n' "$(_ws_mtime "$f")" "$(basename "$f" .jsonl)"; done \
    | sort -rn | head -n "$max" | cut -f2-
}
# Arm a workspace so its restored terminals resume Claude. Returns 0 if armed.
_ws_arm_claude() {
  local path="$1"; local -a specs=(); local u
  while IFS= read -r u; do [ -n "$u" ] && specs+=("resume $u"); done <<EOF
$(_ws_recent_sessions "$path")
EOF
  [ "${#specs[@]}" -gt 0 ] || return 1
  _ws_mark_queue "$path" "${specs[@]}"
  return 0
}

_ws_cmd_save() {
  local name="${1:-last}"
  local cfg rp; cfg="$(_ws_ij_config_dir)"; rp="$cfg/options/recentProjects.xml"
  [ -f "$rp" ] || _ws_die "can't find IntelliJ recentProjects.xml (looked in $cfg/options/)"
  mkdir -p "$WS_CONFIG_DIR/sessions"
  local sf="$WS_CONFIG_DIR/sessions/$name"; : > "$sf"
  local path count=0 armed=0 nses
  while IFS= read -r path; do
    [ -n "$path" ] && [ -d "$path" ] || continue
    printf '%s\n' "$path" >> "$sf"; count=$((count+1))
    if _ws_arm_claude "$path"; then
      nses="$(grep -c . "$path/.ws-autoclaude" 2>/dev/null)"
      armed=$((armed+1)); _ws_say "  armed $(basename "$path") ($nses Claude session(s))"
    fi
  done <<EOF
$(_ws_open_projects "$rp")
EOF
  _ws_say "saved '$name': $count open project(s), Claude armed in $armed → $sf"
  _ws_say "restart-safe: enable IntelliJ 'Reopen projects on startup' + terminal restore, then"
  _ws_say "relaunching IntelliJ reopens windows/terminals and resumes Claude. Or run: ws restore $name"
}

_ws_cmd_restore() {
  local name="${1:-last}"
  local sf="$WS_CONFIG_DIR/sessions/$name"
  [ -f "$sf" ] || _ws_die "no saved session '$name' — create one with: ws save"
  local applescript ed path label n=0
  applescript="$(_ws_asset idea_open.applescript)"
  ed="$(_ws_resolve_editor)"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    [ -d "$path" ] || { _ws_err "skip (gone): $path"; continue; }
    label="$(basename "$path")"; n=$((n+1))
    [ -f "$path/.ws-autoclaude" ] || _ws_arm_claude "$path" || true
    _ws_say "restore [$label]"
    if [ "$ed" = none ] || ! command -v "$ed" >/dev/null 2>&1; then continue; fi
    "$ed" "$path" >/dev/null 2>&1 || true
    if [ "$ed" = idea ] && _ws_is_mac && [ -z "${WS_NO_UI:-}" ] && [ -n "$applescript" ]; then
      osascript "$applescript" "$label" 1 1 "$WS_IDEA_WAIT" >/dev/null 2>&1 || true
    fi
  done < "$sf"
  _ws_say "restored $n project(s) from '$name'"
}

_ws_cmd_sessions() {
  local d="$WS_CONFIG_DIR/sessions"
  [ -d "$d" ] && [ -n "$(ls -A "$d" 2>/dev/null)" ] || { _ws_say "no saved sessions (create one: ws save)"; return 0; }
  local f
  for f in "$d"/*; do printf '  %-16s %s project(s)\n' "$(basename "$f")" "$(grep -c . "$f")"; done
}

_ws_cmd_resume() {
  _ws_require_repo
  local name="" repos="" state=pos
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--also) state=repos ;;
      -*)        _ws_err "ignoring unknown flag: $1" ;;
      *) if [ "$state" = repos ]; then repos="$repos $1"; elif [ -z "$name" ]; then name="$1"; fi ;;
    esac
    shift
  done
  name="$(_ws_resolve_name "$name")" || return 1
  _ws_do_resume_one "$name"
  _ws_run_across_split "$name" "" "$repos"
}

_ws_cmd_path() {
  _ws_require_repo
  local name; name="$(_ws_resolve_name "${1:-}")" || return 1
  local dir; dir="$(_ws_dir "$name")"
  [ -d "$dir" ] || _ws_die "no such workspace: $name"
  printf '%s\n' "$dir"
}

_ws_cmd_cd() {   # standalone fallback; the shell wrapper does a real parent cd
  local dir; dir="$(_ws_cmd_path "$@")" || return 1
  [ -n "$dir" ] || return 1
  _ws_say "entering $dir (exit to return)"
  cd "$dir" || return 1
  exec "${SHELL:-/bin/bash}"
}

_ws_cmd_ls() {
  _ws_require_repo
  local base repo; base="$(_ws_base)"; repo="$(_ws_repo_name)"
  if [ ! -d "$base" ] || [ -z "$(ls -A "$base" 2>/dev/null)" ]; then
    _ws_say "no workspaces for '$repo' — create one: ws -n <name>"; return 0
  fi
  printf 'workspaces for %s  (%s):\n' "$repo" "$base"
  local n dir branch dirty up ab behind ahead dock rel
  for n in $(_ws_names); do
    dir="$base/$n"; [ -d "$dir" ] || continue
    branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then dirty="● dirty"; else dirty="✓ clean"; fi
    up="$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
    ab=""
    if [ -n "$up" ]; then
      read behind ahead <<< "$(git -C "$dir" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null)"
      [ "${ahead:-0}" -gt 0 ] 2>/dev/null && ab="$ab ↑$ahead"
      [ "${behind:-0}" -gt 0 ] 2>/dev/null && ab="$ab ↓$behind"
    else
      ab=" (no upstream)"
    fi
    if ls "$dir"/*.override.y*ml >/dev/null 2>&1; then dock=" · docker"; else dock=""; fi
    rel="$(git -C "$dir" log -1 --format=%cr 2>/dev/null)"
    printf '  %-26s %-14s %s%s%s · %s\n' "$n" "$branch" "$dirty" "$ab" "$dock" "${rel:-—}"
  done
}

_ws_cmd_rm() {
  _ws_require_repo
  local force=0 delbranch=0 name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force)  force=1 ;;
      -b|--branch) delbranch=1 ;;
      -*)          _ws_err "ignoring unknown flag: $1" ;;
      *)           name="$1" ;;
    esac; shift
  done
  name="$(_ws_resolve_name "$name")" || return 1
  local dir; dir="$(_ws_dir "$name")"
  [ -d "$dir" ] || _ws_die "no such workspace: $name"
  if [ "$force" -eq 0 ]; then
    local issues="" ahead up
    [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ] && issues="uncommitted changes"
    up="$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
    if [ -n "$up" ]; then
      ahead="$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null)"
      [ "${ahead:-0}" -gt 0 ] 2>/dev/null && issues="${issues:+$issues, }$ahead unpushed commit(s)"
    fi
    if [ -n "$issues" ]; then
      _ws_err "workspace '$name' has $issues."
      printf 'ws: remove anyway? [y/N] ' >&2; local ans; read -r ans
      case "$ans" in y|Y|yes|YES) ;; *) _ws_err "aborted"; return 1 ;; esac
    fi
  fi
  if [ "$force" -eq 1 ]; then
    git worktree remove --force "$dir" || _ws_die "could not remove worktree"
  else
    git worktree remove "$dir" 2>/dev/null || { _ws_err "worktree busy/dirty — retry with: ws rm $name --force"; return 1; }
  fi
  git worktree prune
  _ws_say "removed workspace '$name'"
  if [ "$delbranch" -eq 1 ]; then
    git branch -D "$name" 2>/dev/null && _ws_say "deleted branch '$name'" || _ws_err "could not delete branch '$name'"
  else
    _ws_say "branch '$name' kept — delete with: git branch -D $name"
  fi
}

_ws_cmd_seed() {
  _ws_require_repo
  local name; name="$(_ws_resolve_name "${1:-}")" || return 1
  local dir; dir="$(_ws_dir "$name")"
  [ -d "$dir" ] || _ws_die "no such workspace: $name"
  _ws_seed "$dir"; _ws_say "re-seeded $name"
}

_ws_cmd_docker() {
  _ws_require_repo
  local name="${1:-}" arg2="${2:-}" off=0 slot=0
  if [ "$name" = off ]; then off=1; name="${2:-}"; arg2=""; fi
  [ "$arg2" = off ] && off=1
  case "$arg2" in ''|off|*[!0-9]*) ;; *) slot="$arg2" ;; esac
  name="$(_ws_resolve_name "$name")" || return 1
  local dir; dir="$(_ws_dir "$name")"
  [ -d "$dir" ] || _ws_die "no such workspace: $name"
  local base="" f
  for f in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
    [ -f "$dir/$f" ] && { base="$f"; break; }
  done
  [ -n "$base" ] || _ws_die "no compose file in $dir — nothing to isolate"
  local stem="${base%.*}" ext="${base##*.}" override
  override="$stem.override.$ext"
  if [ "$off" -eq 1 ]; then
    rm -f "$dir/$override" && _ws_say "docker isolation OFF for '$name' (removed $override)"; return 0
  fi
  local py gen out excl
  py="$(command -v python3 || command -v python)" || _ws_die "python not found (needed for ws -d)"
  gen="$(_ws_asset gen_override.py)" || _ws_die "gen_override.py not found next to ws"
  out="$("$py" "$gen" "$dir/$base" "$name" "$slot" "$(_ws_repo_name)")" || return 1
  excl="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/info/exclude"
  [ -f "$excl" ] && { grep -qxF "$override" "$excl" 2>/dev/null || printf '%s\n' "$override" >> "$excl"; }
  _ws_say "docker isolation ON for '$name'  (project: $(printf '%s\n' "$out" | sed -n 2p))"
  printf '%s\n' "$out" | sed -n '3,$p' | sed 's/^port /  /'
  printf '  run:     cd "%s" && make run   (auto-merges %s)\n' "$dir" "$override"
  printf '  disable: ws -d %s off\n' "$name"
}

_ws_check() {   # _ws_check "label" "shell test cmd"
  if eval "$2" >/dev/null 2>&1; then printf '  [ok] %s\n' "$1"; else printf '  [--] %s\n' "$1"; fi
}
_ws_cmd_doctor() {
  local py; py="$(command -v python3 || command -v python || echo python3)"
  printf 'ws doctor — v%s (%s)\n' "$WS_VERSION" "$(uname -s)"
  printf '  config dir : %s%s\n' "$WS_CONFIG_DIR" "$( [ -f "$WS_CONFIG_DIR/config" ] && echo ' (config loaded)')"
  printf '  worktrees  : %s\n' "$WS_HOME"
  printf '  editor     : %s -> %s\n' "$WS_EDITOR" "$(_ws_resolve_editor)"
  printf '  seed files : %s\n' "$WS_COPY"
  _ws_check "git"                     "command -v git"
  _ws_check "claude CLI"              "command -v claude"
  _ws_check "editor launcher"         "[ \"$(_ws_resolve_editor)\" = none ] || command -v $(_ws_resolve_editor)"
  _ws_check "python (for ws -d)"      "command -v python3 || command -v python"
  _ws_check "PyYAML (for ws -d)"      "$py -c 'import yaml'"
  _ws_check "docker compose (ws -d)"  "docker compose version"
  _ws_check "fzf (fuzzy picker)"      "command -v fzf"
  if _ws_is_mac; then
    if osascript -e 'tell application "System Events" to return name of first process' >/dev/null 2>&1; then
      printf '  [ok] macOS Accessibility/Automation for this terminal\n'
    else
      printf '  [--] macOS Accessibility/Automation — grant it (see README) or set WS_NO_UI=1\n'
    fi
  fi
  if _ws_in_repo; then printf '  repo       : %s  (%s workspaces)\n' "$(_ws_repo_name)" "$(_ws_names | grep -c . )"; fi
}

_ws_help() {
  cat <<EOF
ws v$WS_VERSION — per-branch worktree workspaces (open in your editor + Claude)

  ws -n <name> [base] [-- <prompt>]  new workspace; optional Claude starting prompt
  ws            (or ws -r)           resume: pick a workspace (fzf/menu) + open it
  ws -r <name>                       resume a specific one (Claude --continue)
  ws -n/-r <name> -a <repo,repo>     also open the same-named workspace in sibling repos
  ws -a <repo,repo>                  set up your CURRENT workspace in other repos too
  ws -u [repo,repo]                  fetch + rebase workspace(s) onto latest main (no repos = this + all same-named)
  ws save [session]                  snapshot open IntelliJ projects + arm Claude resume (default: 'last')
  ws restore [session]               reopen a saved session's windows (Claude resumes in each)
  ws sessions                        list saved sessions
  ws cd [name]                       cd this shell into a workspace (needs shell hook)
  ws -l         (ls|status)          list workspaces with branch/dirty/ahead-behind
  ws -rm [name] [-f] [-b]            remove (-f force, -b also delete branch)
  ws seed [name]                     re-copy seed files (e.g. after .env changed)
  ws -d [name] [slot|off]            isolate docker stack for concurrent runs (slot 1-5)
  ws doctor                          check your environment
  ws version | -h

worktrees: $WS_HOME/<repo>/<name>     config: $WS_CONFIG_DIR/config
EOF
}

# --------------------------------------------------------------------------- #
# dispatch
# --------------------------------------------------------------------------- #
main() {
  local cmd="${1:-}"
  case "$cmd" in
    new|-n|--new)                shift; _ws_cmd_new "$@" ;;
    resume|switch|-r|--resume)   shift; _ws_cmd_resume "$@" ;;
    -a|--also|also)              shift; _ws_cmd_also "$@" ;;
    -u|--update|update)          shift; _ws_cmd_update "$@" ;;
    save)                        shift; _ws_cmd_save "$@" ;;
    restore)                     shift; _ws_cmd_restore "$@" ;;
    sessions)                    shift; _ws_cmd_sessions ;;
    cd)                          shift; _ws_cmd_cd "$@" ;;
    path|--print-dir)            shift; _ws_cmd_path "$@" ;;
    ls|list|status|-l|--list)    shift; _ws_cmd_ls ;;
    rm|remove|-rm|--remove)      shift; _ws_cmd_rm "$@" ;;
    seed)                        shift; _ws_cmd_seed "$@" ;;
    docker|-d|--docker)          shift; _ws_cmd_docker "$@" ;;
    doctor)                      shift; _ws_cmd_doctor ;;
    --list-names)                _ws_names ;;                 # completion helper
    version|-v|--version)        printf 'ws %s\n' "$WS_VERSION" ;;
    help|-h|--help)              _ws_help ;;
    "")                          _ws_cmd_resume ;;
    -*)                          _ws_err "unknown option '$cmd'"; _ws_help; exit 1 ;;
    *)
      if _ws_in_repo && [ -d "$(_ws_dir "$cmd")" ]; then _ws_cmd_resume "$cmd"
      else _ws_err "unknown command '$cmd' (new workspace? ws -n \"$cmd\")"; exit 1; fi ;;
  esac
}
main "$@"
